---
import "./Layout.module.css";
import "../styles/palette.css";
import { LOCALES, DEFAULT_LOCALE, stripLocale, withLocale, type Locale } from "../i18n";
import { seo } from "../i18n/seo";

interface Props {
    lang?: Locale;
    title?: string;
    description?: string;
    keywords?: string;
    seoKey?: keyof (typeof seo)["en"];
}

const SITE_NAME = "GeoRail";
const SITE_URL = "https://georail.app";
const OG_IMAGE = `${SITE_URL}/og-image.png`;

const { lang = DEFAULT_LOCALE, seoKey } = Astro.props;
const fallback = seoKey ? seo[lang][seoKey] : seo[lang].home;
const title = Astro.props.title ?? fallback.title;
const description = Astro.props.description ?? fallback.description;
const keywords = Astro.props.keywords ?? fallback.keywords;

const basePath = stripLocale(Astro.url.pathname);
const altUrls = LOCALES.map((l) => ({
    hreflang: l,
    href: new URL(withLocale(basePath, l), SITE_URL).href,
}));
const canonical = altUrls.find((a) => a.hreflang === lang)!.href;
const xDefaultHref = altUrls.find((a) => a.hreflang === DEFAULT_LOCALE)!.href;

const OG_LOCALES: Record<Locale, string> = { en: "en_US", nl: "nl_NL" };
const ogLocale = OG_LOCALES[lang];
const ogAlternateLocales = LOCALES.filter((l) => l !== lang).map((l) => OG_LOCALES[l]);

const NON_DEFAULT_LOCALES = LOCALES.filter((l) => l !== DEFAULT_LOCALE);
const PAIRED_PATHS = ["/", "/account", "/account/", "/credits", "/credits/", "/user-routes", "/user-routes/", "/faq", "/faq/"];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <script is:inline define:vars={{ LOCALE_PREFIXES: NON_DEFAULT_LOCALES, PAIRED_PATHS }}>
            (function () {
                try {
                    var p = location.pathname;
                    for (var i = 0; i < LOCALE_PREFIXES.length; i++) {
                        var prefix = '/' + LOCALE_PREFIXES[i];
                        if (p === prefix || p.indexOf(prefix + '/') === 0) return;
                    }
                    if (PAIRED_PATHS.indexOf(p) === -1) return;
                    var saved = localStorage.getItem('locale');
                    var pref = null;
                    if (saved && LOCALE_PREFIXES.indexOf(saved) !== -1) {
                        pref = saved;
                    } else if (!saved && navigator.language) {
                        var browserLang = navigator.language.toLowerCase().slice(0, 2);
                        if (LOCALE_PREFIXES.indexOf(browserLang) !== -1) pref = browserLang;
                    }
                    if (pref) {
                        var target = '/' + pref + (p === '/' ? '/' : p);
                        location.replace(target + location.search + location.hash);
                    }
                } catch (e) { }
            })();
        </script>
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {altUrls.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
        <meta name="keywords" content={keywords} />
        <meta name="theme-color" content="#3473E6" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={OG_IMAGE} />
        <meta property="og:image:alt" content="A train driving through a photorealistic 3D map of the Netherlands" />
        <meta property="og:locale" content={ogLocale} />
        {ogAlternateLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={OG_IMAGE} />

        <!-- Icons -->
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <link rel="preload" href="/logo.svg" as="image" />

        <!-- Structured data -->
        <script is:inline type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "VideoGame",
            "name": SITE_NAME,
            "url": SITE_URL,
            "description": seo[lang].home.description,
            "applicationCategory": "Game",
            "operatingSystem": "Web",
            "genre": ["Simulation", "Train Simulator"],
            "publisher": {
                "@type": "Organization",
                "name": "Terminarch Games"
            },
            "inLanguage": lang
        })} />
    </head>
    <body>
        <div
            id="splash"
            style="position:fixed;inset:0;z-index:9999;background:radial-gradient(circle at 50% 40%,rgba(52,115,230,1) 0%,rgba(19,52,158,1) 100%);display:flex;align-items:center;justify-content:center;"
        >
            <div
                id="splash-logo-pulse"
                style="display:flex;align-items:center;justify-content:center;"
            >
                <img
                    id="splash-logo"
                    src="/logo.svg"
                    alt=""
                    fetchpriority="high"
                    style="width:120px;height:120px;filter:drop-shadow(0 8px 24px rgba(0,0,0,0.35));opacity:0;"
                    onload="this.style.animation='splashIn .6s cubic-bezier(.16,1,.3,1) .15s forwards';document.getElementById('splash-logo-pulse').style.animation='splashPulse 2s ease-in-out .9s infinite';"
                />
            </div>
        </div>
        <style>
            @keyframes splashIn {
                0% {
                    opacity: 0;
                    transform: scale(0.7);
                }
                100% {
                    opacity: 1;
                    transform: scale(1);
                }
            }
            @keyframes splashPulse {
                0%,
                100% {
                    transform: scale(1);
                }
                50% {
                    transform: scale(1.06);
                }
            }
        </style>
        <slot />
        <div id="tweakpane-container"></div>
    </body>
</html>
