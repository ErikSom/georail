---
import './Layout.module.css';
import '../styles/palette.css';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Explore railway networks in 3D. Plan journeys and ride along real train routes from your browser." />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body>
        <div id="splash" style="position:fixed;inset:0;z-index:9999;background:radial-gradient(circle at 50% 40%,rgba(52,115,230,1) 0%,rgba(19,52,158,1) 100%);display:flex;align-items:center;justify-content:center;">
            <img src="/logo.svg" alt="" style="width:120px;height:120px;filter:drop-shadow(0 8px 32px rgba(0,0,0,0.3));animation:splashIn .6s cubic-bezier(.16,1,.3,1) forwards;" />
        </div>
        <style>
            @keyframes splashIn { 0% { opacity:0; transform:scale(.7); } 100% { opacity:1; transform:scale(1); } }
        </style>
        <slot />
        <div id="tweakpane-container"></div>
    </body>
</html>
