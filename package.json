{
  "name": "georail",
  "version": "0.6.0",
  "description": "Georail repository for both the App & Server",
  "homepage": "https://github.com/ErikSom/georail#readme",
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "bump": "release-it --increment",
    "release": "release-it",
    "test": "echo 'No tests yet' && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErikSom/georail.git"
  },
  "private": true,
  "author": "Erik Sombroek",
  "type": "module",
  "main": "app/src/pages/index.astro",
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@release-it/conventional-changelog": "^10.0.4",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cz-git": "^1.12.0",
    "husky": "^9.1.7",
    "release-it": "^19.2.4"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
